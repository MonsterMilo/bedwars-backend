MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bedwars
# Fallback only - Coral (below) is the primary source for player data, so this
# can be left stale/expired without breaking anything unless Coral itself errors.
HYPIXEL_API_KEY=your-hypixel-api-key
# Used both for the legacy urchin.ws cheater-tag lookup and as the Coral API
# (api.urchin.gg) key for player data - needs the Player Data/Hypixel permission.
URCHIN_KEY=your-urchin-key
# Shared secret required (as the x-admin-key header) to add/edit/delete sweats.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-me
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=https://monstermilo.github.io
