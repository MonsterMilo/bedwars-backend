MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bedwars
# Fallback only - Coral (below) is the primary source for player data, so this
# can be left stale/expired without breaking anything unless Coral itself errors.
HYPIXEL_API_KEY=your-hypixel-api-key
# Used both for the legacy urchin.ws cheater-tag lookup and as the Coral API
# (api.urchin.gg) key for player data - needs the Player Data/Hypixel permission.
URCHIN_KEY=your-urchin-key
# Shared secret required (as the x-admin-key header) to add/edit/delete sweats.
# Full access: any field, any age, delete included. Generate one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-me
# Optional. Can add sweats with no restriction, and can edit any field or
# delete a sweat - but only one added within the last 7 days; older entries
# are 403'd. Generate the same way as ADMIN_KEY, with a different value.
TRUSTED_KEY=change-me-too
# Optional. Restricted key for the /tracker plugin: can add sweats and toggle
# their beaten-by/cheating/boosting flags, but can never edit stats or delete,
# regardless of age. Generate the same way as ADMIN_KEY, with a different value.
ADD_KEY=change-me-as-well
# Optional. Discord bot "Sweat Log": posts new sweats to a channel with
# buttons, and answers /sweat <name>. Off unless the first four are set.
# From the Discord Developer Portal (discord.com/developers/applications):
# General Information > Application ID
DISCORD_APP_ID=
# General Information > Public Key
DISCORD_PUBLIC_KEY=
# Bot > Reset Token. Secret: anyone with it controls the bot.
DISCORD_BOT_TOKEN=
# Right-click the channel > Copy Channel ID (needs Developer Mode on in Discord).
DISCORD_CHANNEL_ID=
# Who's who, so button clicks count as that roster member:
# roster id:Discord user id, comma-separated. Right-click a user > Copy User ID.
DISCORD_ROSTER=milo:123456789012345678,potat:234567890123456789
# Optional. Site the Discord cards link to (defaults to the GitHub Pages site).
SITE_URL=https://monstermilo.github.io/bedwars-frontend/
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=https://monstermilo.github.io
