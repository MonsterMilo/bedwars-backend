MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bedwars
# Fallback only - Bordic is the primary source for player data, so this can be
# left stale/expired without breaking anything unless Bordic itself errors.
HYPIXEL_API_KEY=your-hypixel-api-key
# Coral API (api.urchin.gg) key, used for Urchin cheater tags (/urchin/:name).
URCHIN_KEY=your-urchin-key
# Write keys, sent as the x-admin-key header to add/edit/delete sweats.
# KEY_ADMIN: full access, and the only key that can read the Activity log.
# Generate each one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KEY_ADMIN=change-me
# One personal key per roster member. Notes are signed with the owner's name.
# KEY_MILO has full access; the rest can add anything, edit entries from the
# last 30 days and delete ones from the last 10. Unset ones are just disabled.
KEY_MILO=
KEY_POTAT=
KEY_ABOI=
KEY_ZOIV=
KEY_MAX=
KEY_SQOZ=
KEY_KERMIT=
KEY_SSENT=
KEY_KEY=
# Optional. Denicker nick-lookup API key, proxied through /denicker so it never
# reaches the browser. Without it the website uses the scraped sources only.
DENICKER_API_KEY=
# Optional. Discord bot "Sweat Log": posts new sweats to a channel with
# buttons, and answers /sweat <name>. Off unless the first four are set.
# From the Discord Developer Portal (discord.com/developers/applications):
# General Information > Application ID
DISCORD_APP_ID=
# General Information > Public Key
DISCORD_PUBLIC_KEY=
# Bot > Reset Token. Secret: anyone with it controls the bot.
DISCORD_BOT_TOKEN=
# Right-click the channel > Copy Channel ID (needs Developer Mode on in Discord).
DISCORD_CHANNEL_ID=
# Who's who, so button clicks count as that roster member:
# roster id:Discord user id, comma-separated. Right-click a user > Copy User ID.
DISCORD_ROSTER=milo:123456789012345678,potat:234567890123456789
# Optional. Card theme for people who haven't picked one with /theme
# (neon, casefiles, ledger, deepcurrent, skyisles, hollowgrave). Defaults to neon.
DISCORD_DEFAULT_THEME=
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=https://monstermilo.github.io
